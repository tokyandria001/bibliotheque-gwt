<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">

  <ui:style>
    .form { padding: 12px; min-width: 320px; }
    .ligne { margin-bottom: 8px; }
    .etiquette { display: inline-block; width: 90px; }
    .erreur { color: #c0392b; margin: 8px 0; min-height: 1em; }
    .boutons { text-align: right; margin-top: 12px; }
  </ui:style>

  <g:DialogBox text="Ajouter un livre" modal="true" glassEnabled="true">
    <g:HTMLPanel styleName="{style.form}">
      <div class="{style.ligne}">
        <span class="{style.etiquette}">Titre</span>
        <g:TextBox ui:field="champTitre"/>
      </div>
      <div class="{style.ligne}">
        <span class="{style.etiquette}">Auteur</span>
        <g:TextBox ui:field="champAuteur"/>
      </div>
      <div class="{style.ligne}">
        <span class="{style.etiquette}">Année</span>
        <g:IntegerBox ui:field="champAnnee"/>
      </div>
      <div class="{style.ligne}">
        <g:CheckBox ui:field="champDisponible">Disponible</g:CheckBox>
      </div>

      <g:Label ui:field="messageErreur" styleName="{style.erreur}"/>

      <div class="{style.boutons}">
        <g:Button ui:field="boutonAnnuler">Annuler</g:Button>
        <g:Button ui:field="boutonEnregistrer">Enregistrer</g:Button>
      </div>
    </g:HTMLPanel>
  </g:DialogBox>

</ui:UiBinder>